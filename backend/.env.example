PORT=5000
NODE_ENV=development
# Supabase session-pooler URL. Keep the password server-side.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://smart-water-safety-web.vercel.app
DB_POOL_MAX=5
# Optional trusted CA for another PostgreSQL host. Supabase CA is bundled.
DB_SSL_CA_FILE=
