{
  "schema": {
    "event_id": "string (UUID) - unique SOS event identifier",
    "event_type": "enum [SOS_TRIGGERED | SOS_ACKNOWLEDGED | SOS_RESPONDER_DISPATCHED | SOS_RESOLVED | SOS_FALSE_ALARM]",
    "site_id": "string - pilot site identifier",
    "site_name": "string - human-readable site name",
    "timestamp_utc": "ISO 8601 datetime - when the event occurred",
    "reporter": {
      "user_id": "string - anonymized/app user identifier",
      "device_id": "string - mobile device identifier",
      "contact_masked": "string - masked phone number, e.g. +91-98XXXXX210"
    },
    "location": {
      "latitude": "float",
      "longitude": "float",
      "altitude_m": "float (optional, from GPS/DEM)",
      "accuracy_m": "float - GPS accuracy radius",
      "zone": "enum [PLUNGE_POOL | STREAM_CORRIDOR | VIEWPOINT | TRAIL | PARKING | CAMP_SITE | RAILWAY_ZONE | UNKNOWN]"
    },
    "severity": "enum [LOW | MEDIUM | HIGH | CRITICAL]",
    "hazard_context": {
      "trigger_source": "enum [MANUAL_APP_BUTTON | AUTO_GEOFENCE_BREACH | WEARABLE_FALL_DETECT | THIRD_PARTY_REPORT]",
      "live_condition_flags": ["e.g. HIGH_WATER_LEVEL, FLASH_FLOOD_ALERT, SLIPPERY_ROCKS, LOW_VISIBILITY"]
    },
    "nearest_emergency_facility": {
      "name": "string",
      "type": "enum [WATCHTOWER | RANGER_POST | RAILWAY_STATION | PARKING_MUSTER_POINT]",
      "distance_m": "float",
      "eta_min_on_foot": "float"
    },
    "rescue_route_ref": "string - ID of nearest mapped safe/way-out path",
    "status": "enum [OPEN | ACKNOWLEDGED | RESPONDER_EN_ROUTE | RESOLVED | CANCELLED]",
    "resolution": {
      "resolved_at_utc": "ISO 8601 datetime (nullable)",
      "outcome": "enum [SAFE_SELF_EXTRACTED | RESCUED | MEDICAL_EVAC | FALSE_ALARM | UNRESOLVED] (nullable)",
      "responder_id": "string (nullable)"
    },
    "source_geometry_ref": "string - Placemark id from site KML this event is anchored to"
  },

